{
  "opencollection": "1.0.0",
  "info": {
    "name": "Artsy Public Applications Status API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Xapp-Token",
      "value": "{{X-Xapp-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Status",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "API status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.artsy.net/api/status"
          },
          "docs": "Health/status of the API."
        }
      ]
    }
  ],
  "bundled": true
}